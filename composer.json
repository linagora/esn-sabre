{
    "name": "linagora/esn-sabre",
    "version": "1.11.0-dev",
    "description": "SabreDAV Backend for Linagora ESN",
    "keywords": ["WebDAV", "CalDAV", "CardDAV", "iCalendar"],
    "license" : "AGPL-3.0",
    "authors": [{
            "name": "Linagora",
            "homepage" : "http://linagora.com"
        },{
            "name": "Philipp Kewisch",
            "email": "pkewisch@linagora.com",
            "role" : "Initiator"
        }
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/linagora/sabre-vobject.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "https://github.com/linagora/xml.git",
            "no-api": true
        }
    ],
    "config": {
        "preferred-install": "dist",
        "github-protocols": ["https"]
    },
    "require": {
        "php-amqplib/php-amqplib": "^3.3",
        "php": ">=8.4",
        "sabre/dav": "4.7.1",
        "sabre/vobject": "dev-linagora-waiting-merges-5.0.0#ca4ed8fbb64e583b2130634b59178b2e25307cdc",
        "sabre/xml": "dev-linagora-waiting-merges-2.2#e18889b1bc2bbccecf87821b5b83799d54bb45ae",
        "mongodb/mongodb": "^2.5@stable",
        "monolog/monolog": "^3.12",
        "firebase/php-jwt": "^7.0"
    },
    "require-dev" : {
        "phpunit/phpunit" : "^13.4",
        "squizlabs/php_codesniffer": "4.0.4"
    },
    "autoload": {
        "psr-4" : {
            "ESN\\DAV\\"        : "lib/DAV/",
            "ESN\\CalDAV\\"     : "lib/CalDAV/",
            "ESN\\CardDAV\\"    : "lib/CardDAV/",
            "ESN\\DAVACL\\"     : "lib/DAVACL/",
            "ESN\\JSON\\"       : "lib/JSON/",
            "ESN\\Publisher\\"  : "lib/Publisher/",
            "ESN\\Utils\\"      : "lib/Utils/",
            "ESN\\Log\\"        : "lib/Log/"
        }
    },
    "minimum-stability": "dev"
}
