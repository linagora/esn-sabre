server {
  listen 80;
  listen [::]:80 default_server ipv6only=on;

  root /var/www;

  server_name _;

  # The /__krb location when KERBEROS_ENABLED=true, or nothing: rendered by
  # scripts/start.sh from the environment at container boot.
  include /etc/nginx/snippets/kerberos_server.conf;

  location = /.well-known/caldav {
    absolute_redirect off;
    return 301 /calendars;
  }

  location = /.well-known/caldav/ {
    absolute_redirect off;
    return 301 /calendars;
  }

  location = /.well-known/carddav {
    absolute_redirect off;
    return 301 /addressbooks;
  }

  location = /.well-known/carddav/ {
    absolute_redirect off;
    return 301 /addressbooks;
  }

  # The FPM status and ping pages are never served on this port. The pool that runs Sabre has
  # pm.status_path / ping.path set (pm.status_listen needs them to serve the dedicated status pool), so
  # its workers would answer these two URIs themselves, before esn.php and its authentication run: an
  # anonymous reader would see the URI and the user name of every request under way. They are served
  # by the private server of PHP_FPM_STATUS_LISTEN (doc/CONFIGURE.md § "PHP-FPM slow log and status page").
  # Exact matches on the normalised URI, which is what FPM compares (SCRIPT_NAME = $fastcgi_script_name).
  location = /status {
    return 404;
  }

  location = /ping {
    return 404;
  }

  location / {
    # Sends "Authorization: Negotiate" requests to /__krb when KERBEROS_ENABLED=true,
    # or nothing. Being a rewrite, it runs before limit_req and auth_basic
    # whatever its position, and before the OPTIONS short-circuit below.
    include /etc/nginx/snippets/kerberos_location.conf;

    # limit_req directives, or nothing when NGINX_RATE_LIMIT=off: rendered by
    # scripts/start.sh from the environment at container boot.
    include /etc/nginx/snippets/rate_limit_location.conf;

    add_header 'Access-Control-Allow-Origin' "$http_origin" always;
    add_header 'Access-Control-Allow-Methods' 'OPTIONS, GET, HEAD, DELETE, PROPFIND, PUT, PROPPATCH, COPY, MOVE, REPORT, ITIP, ACL, PATCH, POST' always;
    add_header 'Access-Control-Allow-Headers' 'Depth, Authorization, Content-Type, Accept, Prefer, If-Match, X-Http-Method-Override, Destination, Overwrite' always;
    add_header 'Access-Control-Expose-Headers' 'ETag' always;
    add_header 'Access-Control-Allow-Credentials' 'true' always;
    add_header 'Vary' 'Origin' always;

    # The DAV capability headers (Allow, DAV, MS-Author-Via, X-Sabre-Version)
    # are emitted by Sabre (esn.php) on every proxied response. Adding them
    # again here would duplicate them (see #404), so they are only set for the
    # OPTIONS short-circuit below, which is answered by nginx and never reaches
    # PHP. Casing matches Sabre so a single, consistent header is returned.
    if ($request_method = 'OPTIONS') {
        add_header 'Access-Control-Allow-Origin' "$http_origin" always;
        add_header 'Access-Control-Allow-Methods' 'OPTIONS, GET, HEAD, DELETE, PROPFIND, PUT, PROPPATCH, COPY, MOVE, REPORT, ITIP, ACL, PATCH, POST' always;
        add_header 'Access-Control-Allow-Headers' 'Depth, Authorization, Content-Type, Accept, Prefer, If-Match, X-Http-Method-Override, Destination, Overwrite' always;
        add_header 'Access-Control-Expose-Headers' 'ETag' always;
        add_header 'Access-Control-Allow-Credentials' 'true' always;
        add_header 'Vary' 'Origin' always;
        add_header 'Allow' 'OPTIONS, GET, HEAD, DELETE, PROPFIND, PUT, PROPPATCH, COPY, MOVE, REPORT, ITIP' always;
        add_header 'DAV' '1, 3, extended-mkcol, access-control, calendarserver-principal-property-search, calendar-access, calendar-proxy, addressbook, calendarserver-subscribed, resource-sharing, calendarserver-sharing, calendar-auto-schedule, calendar-availability' always;
        add_header 'MS-Author-Via' 'DAV' always;
        add_header 'X-Sabre-Version' '4.7.0' always;
        return 200;
    }

    fastcgi_pass unix:/var/run/php/php-fpm.sock;
    include fastcgi_params;
    fastcgi_param SCRIPT_FILENAME /var/www/esn.php;
    # Set by /__krb only: Sabre must never see a principal coming from here,
    # not even one from the process environment.
    fastcgi_param KRB5_PRINCIPAL "";
    fastcgi_read_timeout 120s;
    proxy_http_version 1.1;

    # _auth_basic_
  }
}
